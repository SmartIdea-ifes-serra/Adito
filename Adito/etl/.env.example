# Copie para etl/.env (fora do git) e preencha.

# De onde vêm as credenciais do SRC e do SigPesq. Escolha explícita, sem padrão:
#   ADITO_CREDENCIAIS=infisical -> lê os segredos no Infisical (bloco abaixo)
#   ADITO_CREDENCIAIS=env       -> lê SRC_USER/SRC_PASSWORD e SIGPESQ_USER/SIGPESQ_PASSWORD deste arquivo
ADITO_CREDENCIAIS=infisical

# Infisical (mesma identidade de máquina do horizon_etl).
# INFISICAL_CLIENT_ID/CLIENT_SECRET/PROJECT_ID são obrigatórios; o resto tem padrão.
INFISICAL_HOST=https://app.infisical.com
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev
INFISICAL_SECRET_PATH=/
# Nomes dos segredos (padrões abaixo; descomente só para trocar):
# INFISICAL_SIGPESQ_USER_SECRET=sigpesq-user
# INFISICAL_SIGPESQ_PASSWORD_SECRET=sigpesq-password
# INFISICAL_SRC_USER_SECRET=src-user
# INFISICAL_SRC_PASSWORD_SECRET=src-password

# Só com ADITO_CREDENCIAIS=env:
# SRC (área autenticada: público-alvo e equipe de execução) — US-ETL-02
SRC_USER=
SRC_PASSWORD=
# SigPesq (download dos relatórios) — US-ETL-03
SIGPESQ_USER=
SIGPESQ_PASSWORD=
